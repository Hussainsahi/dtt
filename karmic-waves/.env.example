# Karmic Waves — server environment variables (never commit a real .env)

# ---- Lead storage: supabase | sheet | memory (memory = dev only, data lost on restart)
LEAD_STORAGE=memory
# Supabase (service role key is SERVER ONLY). Table DDL: docs/supabase-schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads
# Google Sheet via Apps Script web app (append-only)
SHEET_WEBAPP_URL=
SHEET_WEBAPP_SECRET=

# ---- Lead behaviour
PHONE_HASH_SALT=change-me-to-a-long-random-string
LEAD_DEDUPE_HOURS=24
LEAD_RETENTION_DAYS=365
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_PHONE=3
# true = let the page open WhatsApp even if no storage is configured (manual-delivery launch mode). Pixel Lead still fires only on ok:true.
ALLOW_UNSTORED_LEADS=false
# Comma-separated origins allowed to POST /api/lead (empty = same-origin deployment)
ALLOWED_ORIGINS=

# ---- Optional shared rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Meta Pixel / Conversions API (server-side dedupe with the browser Pixel)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_CAPI_SEND_HASHED_PHONE=false
META_GRAPH_VERSION=v21.0

# ---- WhatsApp Cloud API (leave empty → manual delivery mode)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ---- Audio library location: local | url | media
AUDIO_SOURCE=local
AUDIO_LOCAL_DIR=./audio
AUDIO_BASE_URL=
# JSON map { "01-jan_morning.mp3": "<whatsapp media id>", ... } when AUDIO_SOURCE=media
AUDIO_MEDIA_IDS_JSON=
# Frontend-only preview builds may skip the 36-file check. NEVER for production.
SKIP_AUDIO_CHECK=0
